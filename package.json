{
  "name": "rescue-operator",
  "productName": "rescue.Operator",
  "version": "0.12.2",
  "description": "rescue.Operator – Multiplayer-Leitstellensimulator nach Vorbild der bayerischen Integrierten Leitstellen",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env LST_DEV_URL=http://localhost:5173 electron .\"",
    "server": "npm run build:main && node dist/server/standalone.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux dir --x64",
    "dist:mac": "npm run build && electron-builder --mac dir --x64 --arm64",
    "dist:all": "npm run build && node scripts/piper-holen.mjs && electron-builder --win nsis dir --x64 --publish never && electron-builder --linux AppImage pacman dir --x64 --publish never && electron-builder --mac dir --x64 --arm64 --publish never && node scripts/pack-release.mjs"
  },
  "build": {
    "appId": "de.rescueoperator.app",
    "productName": "rescue.Operator",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/exe-icon.cjs",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/piper/win-x64",
          "to": "piper/win-x64"
        },
        {
          "from": "vendor/stimmen",
          "to": "stimmen"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Game;Simulation",
      "executableName": "rescue-operator",
      "extraResources": [
        {
          "from": "vendor/piper/linux-x64",
          "to": "piper/linux-x64"
        },
        {
          "from": "vendor/stimmen",
          "to": "stimmen"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Melvin (https://github.com/nussfuellung/rescueoperator)"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.simulation-games",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Die Spracheingabe für Notrufe und Funk braucht das Mikrofon."
      },
      "extraResources": [
        {
          "from": "vendor/piper/mac-${arch}",
          "to": "piper/mac-${arch}"
        },
        {
          "from": "vendor/stimmen",
          "to": "stimmen"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "nussfuellung",
      "repo": "rescueoperator",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "rescue.Operator",
      "artifactName": "rescue.Operator-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "appImage": {
      "artifactName": "rescue.Operator-${version}.AppImage"
    },
    "pacman": {
      "artifactName": "rescue.Operator-${version}.pacman",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret"
      ],
      "fpm": [
        "--description",
        "rescue.Operator – Multiplayer-Leitstellensimulator nach Vorbild der bayerischen Integrierten Leitstellen"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "qrcode": "^1.5.4",
    "vosk-browser": "^0.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^2.0.3",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "author": "Melvin"
}
